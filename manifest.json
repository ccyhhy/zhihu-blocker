{
  "manifest_version": 3,
  "name": "知乎批量拉黑",
  "description": "预览关键词命中的作者、回答赞同者及粉丝和关注名单，勾选后批量拉黑",
  "version": "1.2.0",
  "minimum_chrome_version": "110",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "*://*.zhihu.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": "icons/icon16.png",
    "default_popup": "popup/popup.html",
    "default_title": "知乎批量拉黑"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.zhihu.com/*"
      ],
      "js": [
        "lib/storage.js",
        "content/scanner.js",
        "content/ui.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
