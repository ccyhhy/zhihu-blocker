{
  "manifest_version": 3,
  "name": "知乎批量拉黑",
  "description": "根据关键词规则自动拉黑知乎用户，支持关注者/粉丝拉黑、回答点赞者拉黑",
  "version": "1.0.0",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "*://*.zhihu.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": "icons/icon16.png",
    "default_popup": "popup/popup.html",
    "default_title": "知乎批量拉黑"
  },
  "content_scripts": [
    {
      "matches": ["*://*.zhihu.com/*"],
      "js": [
        "lib/storage.js",
        "lib/api.js",
        "content/scanner.js",
        "content/ui.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
